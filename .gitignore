# ── 凭据安全(最高优先级,绝不入库)──────────────────
# 用户的真实配置(含天气 Key / HA Token / SSH 账号等),只存本地
config.yaml
config.yml
config.local.*
*.local.yaml
*.local.yml
.env
.env.*
*.token
*.secret
auth.json
secrets/
# HA 真实数据预览图(含家庭实时状态,只本地看,绝不入库)
ha-预览-真实数据.png
*真实数据*.png

# 运行时数据(渲染产物、缓存、上报数据)
data/
# enable_quota.sh 生成的本机上报地址/节流,运行时产物
installers/macos/quota/quota.conf
# 风格预览图(本地查看用,preview_style.py 产物归档;.gitignore 不支持行内注释,故独立成行)
previews/
*.png
!docs/**/*.png
!styles/**/preview/*.png
cache.json
# 本地构建/自检产物(APK、离线渲染图、自检脚本输出);体积大、机器相关,不入库
work/
*.tmp
# 分发包(APK / DMG / EXE)只走 GitHub Release、绝不入库;放仓库根方便拖到 Release 也不会被跟踪
*.apk
*.dmg
*.exe

# Windows 打包产物(build-win-app.ps1 生成,全是可重建的中间物,绝不入库)
.venv-win/
dist/
build/
APP_VERSION
build-pyinstaller.log
installers/windows/app.ico

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Node
node_modules/
npm-debug.log*
# install.sh 下载的本地 Node 运行时(几十 MB,运行时产物)
.node/

# 系统垃圾
.DS_Store
Thumbs.db
*.swp

